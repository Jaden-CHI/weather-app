# ── Database ──────────────────────────────────
POSTGRES_DB=weatherapp
POSTGRES_USER=weather
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://weather:changeme@db:5432/weatherapp

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── 기상청 단기예보/특보 인증키 ─────────────────
# 공공데이터포털(data.go.kr) 일반 인증키(Decoding) 또는
# 기상청 API허브(apihub.kma.go.kr) 인증키 중 하나
KMA_API_KEY=YOUR_KMA_SERVICE_KEY_HERE
# 발급처: datagokr | apihub (비우면 키 길이로 자동 판별)
KMA_API_PROVIDER=

# ── 국립해양조사원 KHOA ────────────────────────
KHOA_API_KEY=YOUR_KHOA_SERVICE_KEY_HERE

# ── Anthropic Claude API ──────────────────────
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# ── 앱 설정 ───────────────────────────────────
USE_MOCK_DATA=true          # true: 더미 데이터 사용 / false: 실제 API 호출
WEATHER_CACHE_TTL=10800     # Redis TTL 초 단위 (기본 3시간)
WORKER_INTERVAL_MINUTES=60  # 배치 수집 주기 (분)

# JMA coordinate forecasts via Open-Meteo require a commercial customer key.
OPEN_METEO_API_KEY=
# Local evaluation only. Never enable on production.
OPEN_METEO_ALLOW_PUBLIC_EVALUATION=false
# Optional override for modern KHOA tides; otherwise use the worker's KHOA_API_KEY.
# A data.go.kr KMA_API_KEY is the last fallback; API Hub keys are never used here.
KHOA_TIDE_API_KEY=
# JMA Japanese regional reference JSON needs no key (not a Korean port forecast).
# Fishing Windy only. Never point these at the Golf Firebase project.
# Set both API and worker after configuring APNs and testing on a real device.
FISHING_TRIP_PUSH_ENABLED=false
FISHING_FIREBASE_PROJECT_ID=fishing-windy-moonyth
FISHING_FIREBASE_SERVICE_ACCOUNT_JSON=
